# Copy this file to session_config.env and fill in your local values.
# session_config.env is ignored by git and should not be shared.

AGX_USER="your-agx-ssh-user"
AGX_HOST="your-agx-host-or-ip"
AGX_DIR="/path/to/agx/project"

PEPPER_IP="your-pepper-host-or-ip"
PYTHON3="/path/to/project/venv/bin/python3"

# Optional; leave true to start startDialogueServer.py from start_session.sh.
START_GPT=true

# Optional OpenAI model for the dialogue server.
# The chat layer defaults to GPT-5-compatible Responses API usage.
OPENAI_MODEL="gpt-5-chat-latest"

# Optional tablet URLs. Set these if your Pepper tablet uses a specific base URL.
PEPPER_TABLET_BASE_URL="http://pepper-tablet/apps/myapp"
